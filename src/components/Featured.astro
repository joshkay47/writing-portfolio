---
import site from '../data/site.json';
import MiniStrip from './MiniStrip.astro';
import Thumb from './Thumb.astro';
import Slot from './Slot.astro';
import { pieces, byId, projects, outletById, formatDate, asset } from '../lib/data.js';

const find = (prefix) => pieces.find((p) => p.title.startsWith(prefix.replace(/\?$/, '')));
const items = site.featured
  .map((f) => (typeof f === 'string' ? { piece: find(f) } : { project: projects[f.project], id: f.project }))
  .filter((f) => f.piece || f.project);
const recordCount = items.reduce((n, f) => n + (f.project ? 2 : 1), 0);
---
<section id="work" class="band">
  <div class="wrap">
    <div class="sec-head"><h2>Selected work</h2><span class="meta">{recordCount} of {pieces.length} records</span></div>
    <div class="feat">
      {items.map((f) => {
        if (f.project) {
          const film = byId[f.project.film];
          const essay = byId[f.project.essay];
          return (
            <article class="card project" data-o="film">
              <div class="row">
                <span>No. <span class="num">{film.n}</span>{essay && ` + ${essay.n}`}</span>
                <span class="src"><i class="dot f-film"></i>{outletById.film.short}</span>
              </div>
              <MiniStrip hits={[film.id, essay?.id].filter(Boolean)} />
              <div class="p-body">
                <Thumb image={film.image} outletName={f.project.name} />
                <div class="p-text">
                  <div class="p-kicker">{film.method}, {formatDate(film)}</div>
                  <h3><a href={film.url} target="_blank" rel="noopener" data-gc={film.title} data-gc-from="Selected work: title">{f.project.name}</a></h3>
                  {f.project.description && <p class="p-desc">{f.project.description}</p>}
                  <a class="p-link" href={film.url} target="_blank" rel="noopener" data-gc={film.title} data-gc-from="Selected work: watch film">→ {f.project.watchLabel}</a>
                  {essay && (
                    <div class="clip" data-o={essay.outlet}>
                      {essay.image && <img class="clip-img" src={asset(essay.image.src)} alt="" loading="lazy" />}
                      <div class="row">
                        <span>No. {essay.n}</span>
                        <span class="src"><i class={`dot f-${essay.outlet}`}></i>{outletById[essay.outlet].short} · {formatDate(essay)}</span>
                      </div>
                      <a class="p-link" href={essay.url} target="_blank" rel="noopener" data-gc={essay.title} data-gc-from="Selected work: clipping">→ {f.project.essayLabel}</a>
                      {f.project.essayNote && <p class="p-note">{f.project.essayNote}</p>}
                    </div>
                  )}
                </div>
              </div>
            </article>
          );
        }
        const p = f.piece;
        const outlet = outletById[p.outlet];
        return (
          <article class="card" data-o={p.outlet}>
            <div class="row">
              <span>No. <span class="num">{p.n}</span></span>
              <span class="src"><i class={`dot f-${p.outlet}`}></i>{outlet.name}</span>
            </div>
            <Thumb image={p.image} outletName={outlet.name} />
            <MiniStrip hits={[p.id]} />
            <h3><a href={p.url} target="_blank" rel="noopener" data-gc={p.title} data-gc-from="Selected work">{p.title}</a></h3>
            <div class="row"><span>{formatDate(p)}</span><span>{p.method}</span></div>
            {p.line ? <p class="c-line">{p.line}</p> : <Slot class="line" label="Card line" hint="One or two sentences" />}
          </article>
        );
      })}
    </div>
  </div>
</section>
